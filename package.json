{
  "name": "miracle-harness-site",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "cf:typegen": "wrangler types worker-configuration.d.ts",
    "check": "npm run cf:typegen && npm run typecheck && npm test && npm run build && npm run deploy:dry-run",
    "db:migrate:local": "wrangler d1 migrations apply miracle-harness-site-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply miracle-harness-site-db --remote",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "npm run build && wrangler dev",
    "test": "npm run test:worker && npm run test:static",
    "test:static": "node --check app.js && node --test test/static-safety.test.mjs",
    "test:worker": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@msw/cloudflare": "^0.0.1",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
